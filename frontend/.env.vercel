# Holy Grail dashboard — Vercel environment variables
#
# Add these in Vercel: Project → Settings → Environment Variables
# (select all environments: Production, Preview, Development).
#
# These are the ONLY two the app needs. Both are read in src/lib/supabase.ts.
# The anon key is PUBLIC by design (it's safe in the client bundle; access is
# governed by Supabase RLS, currently open). Do NOT put the service_role key here —
# that stays server-side only (bot + migrations).

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
