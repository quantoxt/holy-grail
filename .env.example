# Holy Grail — Live Trading Bot
# Copy to .env and fill in real values. .env is gitignored.

# --- Bot config ---
MARKET_MODE=forex                    # forex | crypto
FOREX_SYMBOLS=XAUUSD,XAGUSD,EURUSD,GBPUSD
CRYPTO_SYMBOLS=BTCUSDT
TIMEFRAME=5m
BASE_STAKE=0.01
PAPER=0                              # 0 = live orders, 1 = paper (simulated)

# --- Kronos (pre-trained, zero-shot) ---
KRONOS_PATH=model/Kronos             # path to the Kronos model code

# --- Supabase (local Docker) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Binance (crypto mode) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram (alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: MT5 credentials are in data/mt5_accounts.json (multi-account, switchable).
