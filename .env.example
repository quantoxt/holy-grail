# Holy Grail — Live Trading Bot
# Copy to .env and fill in real values. .env is gitignored.
#
# Single broker: all instruments (forex, metals, crypto-CFD) trade via one MT5
# account. Symbols are auto-discovered from the broker and curated at runtime
# (dashboard → bot_config) — there are no symbol/env-mode knobs here anymore.

# --- Bot config ---
TIMEFRAME=5m
BASE_STAKE=0.01
# MARKET_MODE is vestigial (still logged to DB columns); provider selection no
# longer branches on it. Leave as forex or omit.
MARKET_MODE=forex

# --- Kronos (pre-trained, zero-shot) ---
KRONOS_PATH=model/Kronos             # path to the Kronos model code

# --- Supabase (local Docker; use cloud URL+key in prod) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Telegram (alerts) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: MT5 credentials are in data/mt5_accounts.json (multi-account, switchable
# from the dashboard — active account is mirrored into this file on switch).
